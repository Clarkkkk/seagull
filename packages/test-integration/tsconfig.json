{
  "extends": "@acme/tsconfig/compiled-package.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "paths": {
      "~/*": [
        "../../apps/expo/src/*"
      ]
    }
  },
  "include": [
    "src",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
