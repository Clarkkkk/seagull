# Root env file for local dev (monorepo)
#
# Usage:
# - Copy to ".env" at repo root
# - Apps/scripts already load ../../.env (see apps/*/package.json "with-env")
#
# IMPORTANT:
# - Do not commit real secrets.

########################################
# Database (Neon Postgres)
########################################
# Recommended canonical variable
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

########################################
# Better Auth (Discord OAuth)
########################################
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Optional in dev, required in prod
AUTH_SECRET=""

########################################
# Map provider (server-side: tRPC map.*)
########################################
# Currently supported: mapbox
MAP_PROVIDER="mapbox"
MAPBOX_ACCESS_TOKEN=""

########################################
# Expo (react-native-maps on Android needs Google Maps SDK key)
########################################
# Used by apps/expo/app.config.ts (injected at build time)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=""

########################################
# S3 compatible storage (wishlist jar images)
########################################
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""
# For MinIO or some R2 setups
S3_FORCE_PATH_STYLE="false"

########################################
# Xiaohongshu link parser (TikHub)
########################################
TIKHUB_API_TOKEN=""

########################################
# S3 compatible storage (wishlist images)
########################################
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"
